{
  "name": "comandos-linux",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run course:package && npm run content:check && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint src scripts tests",
    "content:migrate": "node scripts/migrate-content.mjs",
    "content:check": "node scripts/check-content.mjs",
    "config:ssm": "node scripts/load-ssm.mjs",
    "lab:build": "node scripts/build-ec2-image.mjs",
    "lab:local": "docker compose -f labs/compose.yml up --build",
    "backend:bundle": "node scripts/bundle-backend.mjs",
    "lab:pack": "bash scripts/prepare-ec2-pack.sh",
    "lab:deploy": "npm run backend:bundle && node scripts/deploy-labs.mjs",
    "course:package": "node scripts/package-course-starter.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.1147.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-select": "^2.3.8",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "aws-amplify": "^6.22.1",
    "coi-serviceworker": "0.1.7",
    "i18next": "^26.4.2",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-router-dom": "^7.18.4",
    "xterm-pty": "^0.12.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "acorn": "^8.19.0",
    "cheerio": "^1.2.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
