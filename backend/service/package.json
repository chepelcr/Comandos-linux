{
  "name": "linux-lab-progress",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Account-owned course progress and preferences API",
  "scripts": {
    "check": "tsc --noEmit",
    "build:lambda": "esbuild lambda.cts --platform=node --bundle --format=cjs --outfile=dist/lambda.js --external:@aws-sdk/* --external:pg-native",
    "package:lambda": "bash scripts/build-lambda.sh",
    "test": "vitest run",
    "dev": "cross-env NODE_ENV=development tsx src/index.ts",
    "generate:swagger": "node scripts/generate-swagger-spec.cjs",
    "generate:swagger:dist": "node scripts/generate-swagger-spec.cjs --dist"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1147.0",
    "@aws-sdk/client-ec2": "^3.1147.0",
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/client-scheduler": "^3.1147.0",
    "@aws-sdk/client-ssm": "^3.1147.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^4.21.0",
    "serverless-http": "^4.0.0",
    "swagger-jsdoc": "^6.2.8",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.0",
    "@types/cors": "^2.8.0",
    "@types/express": "4.17.21",
    "@types/node": "^22.0.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^4.0.0"
  }
}
